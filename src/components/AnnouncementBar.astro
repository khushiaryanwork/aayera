---
import ArrowIcon from './ArrowIcon.astro';
import type { Site } from '../lib/types';
const { site } = Astro.props as { site: Site };
const { announcement: a } = site;

// simple line icons (24×24, stroke = currentColor)
const ICONS: Record<string, string> = {
  email: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 6.5 8.5 6.5 8.5-6.5"/>',
  phone: '<path d="M6.6 3.5h2.6l1.4 4-2 1.3a12 12 0 0 0 6.6 6.6l1.3-2 4 1.4v2.6a2 2 0 0 1-2.2 2A17 17 0 0 1 4.6 5.7a2 2 0 0 1 2-2.2z"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
};
const icon = (k: string) => `<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ICONS[k] ?? ''}</svg>`;
---
{site.announcementOn && (
  <div class="abar" id="abar">
    <ul class="abar-contact">
      <li><a href={`mailto:${site.email}`}><Fragment set:html={icon('email')} /><span>{site.email}</span></a></li>
      {site.phones.map((p, i) => (
        <li class={i > 0 ? 'abar-more' : undefined}><a href={`tel:${p.number}`}><Fragment set:html={icon('phone')} /><span>{p.label}</span></a></li>
      ))}
      {site.hours && <li class="abar-hours"><Fragment set:html={icon('clock')} /><span>{site.hours}</span></li>}
    </ul>
    {a.message && (
      <p class="abar-msg">
        {a.href ? <a href={a.href}>{a.message}{a.linkLabel && <strong>{a.linkLabel} <ArrowIcon /></strong>}</a> : a.message}
      </p>
    )}
  </div>
)}
