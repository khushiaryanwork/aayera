---
import type { Site } from '../lib/types';
const { site } = Astro.props as { site: Site };

// filled brand marks (24×24) and colours for the floating buttons
const BRANDS: Record<string, { name: string; bg: string; fg: string; d: string }> = {
  linkedin: {
    name: 'LinkedIn', bg: '#0A66C2', fg: '#fff',
    d: 'M5.3 9.2h3v9.6h-3zM6.8 4.4a1.75 1.75 0 1 1 0 3.5 1.75 1.75 0 0 1 0-3.5zM10.2 9.2h2.9v1.3c.4-.76 1.38-1.56 2.85-1.56 3.05 0 3.6 2 3.6 4.6v5.26h-3v-4.66c0-1.11-.02-2.54-1.55-2.54-1.55 0-1.79 1.21-1.79 2.46v4.74h-3z',
  },
  x: {
    name: 'X (Twitter)', bg: '#000', fg: '#fff',
    d: 'M17.75 3h3.07l-6.7 7.66L22 21h-6.17l-4.83-6.32L5.47 21H2.4l7.17-8.2L2 3h6.33l4.37 5.78zm-1.08 16.18h1.7L7.4 4.73H5.58z',
  },
  facebook: { name: 'Facebook', bg: '#1877F2', fg: '#fff', d: 'M14 21v-7.6h2.6l.4-3h-3V8.5c0-.87.25-1.46 1.5-1.46H17V4.36A21 21 0 0 0 14.7 4.2c-2.3 0-3.8 1.4-3.8 3.95v2.25H8.3v3H11V21z' },
  instagram: { name: 'Instagram', bg: '#E1306C', fg: '#fff', d: 'M12 7.4a4.6 4.6 0 1 1 0 9.2 4.6 4.6 0 0 1 0-9.2zm0 1.8a2.8 2.8 0 1 0 0 5.6 2.8 2.8 0 0 0 0-5.6zM16.9 6a1.1 1.1 0 1 1 0 2.2 1.1 1.1 0 0 1 0-2.2zM8 3h8a5 5 0 0 1 5 5v8a5 5 0 0 1-5 5H8a5 5 0 0 1-5-5V8a5 5 0 0 1 5-5zm0 1.8A3.2 3.2 0 0 0 4.8 8v8A3.2 3.2 0 0 0 8 19.2h8a3.2 3.2 0 0 0 3.2-3.2V8A3.2 3.2 0 0 0 16 4.8z' },
  youtube: { name: 'YouTube', bg: '#FF0000', fg: '#fff', d: 'M21.6 7.2a2.5 2.5 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4a2.5 2.5 0 0 0-1.8 1.8C2 8.8 2 12 2 12s0 3.2.4 4.8a2.5 2.5 0 0 0 1.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8c.4-1.6.4-4.8.4-4.8s0-3.2-.4-4.8zM10 15V9l5.2 3z' },
  whatsapp: { name: 'WhatsApp', bg: '#25D366', fg: '#fff', d: 'M12 3a9 9 0 0 0-7.8 13.5L3 21l4.6-1.2A9 9 0 1 0 12 3zm4.4 12.6c-.2.6-1.1 1.1-1.6 1.2-.4 0-.9.1-2.9-.7-2.4-1-4-3.4-4.1-3.6-.1-.2-1-1.3-1-2.5s.6-1.8.9-2c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 1.9c.1.1.1.3 0 .5l-.3.5-.4.4c-.1.1-.3.3-.1.6.2.3.7 1.2 1.6 1.9 1 .9 1.9 1.2 2.2 1.3.3.1.4.1.6-.1l.8-1c.2-.3.4-.2.6-.1l1.8.9c.3.1.4.2.5.3 0 .2 0 .7-.2 1.3z' },
};
const items = site.floatingSocials ? site.socials.filter((s) => BRANDS[s.platform]) : [];
---
{items.length > 0 && (
  <div class="fsoc" id="fsoc">
    <ul class="fsoc-list" id="fsoc-list" aria-label="Follow Aayera">
      {items.map((s, i) => {
        const b = BRANDS[s.platform];
        return (
          <li style={`--i:${items.length - 1 - i}`}>
            <a href={s.url} style={`--bg:${b.bg};--fg:${b.fg}`} aria-label={`Aayera on ${b.name}`} tabindex="-1"
               {...(s.url.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}>
              <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path fill="currentColor" d={b.d} /></svg>
              <span class="fsoc-tip">{b.name}</span>
            </a>
          </li>
        );
      })}
    </ul>
    <button class="fsoc-main" type="button" aria-expanded="false" aria-controls="fsoc-list" aria-label="Follow Aayera on social media">
      <svg class="fsoc-ico-open" viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20 11.5a7.5 7.5 0 0 1-7.5 7.5H7l-3.5 2.5.9-4.2A7.5 7.5 0 1 1 20 11.5z"/><path d="M8.5 11.5h.01M12.3 11.5h.01M16 11.5h.01" stroke-width="2.6"/>
      </svg>
      <svg class="fsoc-ico-close" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
      <span class="fsoc-tip">Follow us</span>
    </button>
  </div>
)}

<script>
  // one button that opens the social links: hover on desktop, tap/click everywhere
  const root = document.getElementById('fsoc');
  if (root) {
    const btn = root.querySelector<HTMLButtonElement>('.fsoc-main')!;
    const links = [...root.querySelectorAll<HTMLAnchorElement>('.fsoc-list a')];
    const hover = matchMedia('(hover:hover) and (pointer:fine)');
    let pinned = false; // opened by click/tap stays open until closed
    const set = (open: boolean) => {
      root.classList.toggle('open', open);
      btn.setAttribute('aria-expanded', String(open));
      links.forEach((a) => (a.tabIndex = open ? 0 : -1));
    };
    btn.addEventListener('click', () => { pinned = !root.classList.contains('open') || !pinned; set(pinned); });
    root.addEventListener('mouseenter', () => { if (hover.matches) set(true); });
    root.addEventListener('mouseleave', () => { if (hover.matches && !pinned) set(false); });
    document.addEventListener('click', (e) => { if (!root.contains(e.target as Node)) { pinned = false; set(false); } });
    addEventListener('keydown', (e) => { if (e.key === 'Escape' && root.classList.contains('open')) { pinned = false; set(false); btn.focus(); } });
  }
</script>
