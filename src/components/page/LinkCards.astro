---
import ArrowIcon from '../ArrowIcon.astro';
import { imgAttrs, SIZES } from '../../lib/img-attrs';
import SecHead from './SecHead.astro';
const { s } = Astro.props as { s: any };
---
<section class="sec kcsec">
  <SecHead eyebrow={s.eyebrow} heading={s.heading} intro={s.intro} />
  <div class={`kcards n${Math.min(s.cards.length, 4)}`}>
    {s.cards.map((c: any, i: number) => (
      <a class="kcard rv" href={c.href}>
        {c.image && <img {...imgAttrs(c.image, SIZES.quarter)} alt="" loading="lazy" decoding="async">}
        <div class="kcard-txt">
          <h3>{c.title}<span aria-hidden="true"><ArrowIcon size="18" /></span></h3>
          <p>{c.text}</p>
        </div>
      </a>
    ))}
  </div>
</section>
