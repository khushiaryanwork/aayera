---
import type { Site } from '../../lib/types';
import { Rich } from '../Rich';
const { s, site, topics } = Astro.props as { s: any; site: Site; topics: string[] };
const mapSrc = site.mapQuery ? `https://www.google.com/maps?q=${encodeURIComponent(site.mapQuery)}&output=embed` : '';
---
<section class="sec csec">
  <div class="csec-grid">
    <div class="csec-info rv">
      {s.eyebrow && <p class="eyebrow">{s.eyebrow}</p>}
      {s.heading && <h2><Rich text={s.heading} /></h2>}
      {s.intro && <p class="sec-intro">{s.intro}</p>}
      <dl class="cinfo">
        <div><dt>Email</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd></div>
        <div><dt>Phone</dt><dd>{site.phones.map((p) => <a href={`tel:${p.number}`}>{p.label}</a>)}</dd></div>
        {site.hours && <div><dt>Opening hours</dt><dd>{site.hours}</dd></div>}
        <div><dt>Company location</dt><dd>{site.address}</dd></div>
      </dl>
    </div>
    <form class="cform rv" id="enquiry" data-to={site.email} novalidate>
      {s.formHeading && <h3>{s.formHeading}</h3>}
      <div class="frow2">
        <label>Name<input name="name" autocomplete="name" required></label>
        <label>Email<input name="email" type="email" autocomplete="email" required></label>
      </div>
      <div class="frow2">
        <label>Organisation<input name="org" autocomplete="organization"></label>
        <label>I'm interested in
          <select name="topic">{topics.map((t) => <option>{t}</option>)}</select>
        </label>
      </div>
      <label>Message<textarea name="message" rows="5" required></textarea></label>
      <p class="cform-note">This opens your email app with the message ready to send.</p>
      <p class="cform-err" role="alert" hidden>Please add your name, a valid email and a message.</p>
      <button class="btn btn-gold" type="submit">Prepare email →</button>
    </form>
  </div>
  {mapSrc && (
    <div class="cmap rv">
      <iframe src={mapSrc} title={`Map: ${site.address}`} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
  )}
</section>

<script>
  const form = document.getElementById('enquiry') as HTMLFormElement | null;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const f = new FormData(form);
    const v = (k: string) => String(f.get(k) || '').trim();
    const err = form.querySelector<HTMLElement>('.cform-err')!;
    const ok = v('name') && /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(v('email')) && v('message');
    err.hidden = !!ok;
    if (!ok) return;
    const subject = `Enquiry: ${v('topic')}${v('org') ? ` – ${v('org')}` : ''}`;
    const body = `${v('message')}\n\n${v('name')}\n${v('email')}${v('org') ? `\n${v('org')}` : ''}`;
    location.href = `mailto:${form.dataset.to}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  });
</script>
