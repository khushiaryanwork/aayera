---
import type { Site } from '../../lib/types';
import { Rich } from '../Rich';
const { s, site, topics } = Astro.props as { s: any; site: Site; topics: string[] };
// details set on this section, or the Site settings ones
const email = s.email || site.email;
const phones = s.phones?.length ? s.phones : site.phones;
const hours = s.hours || site.hours;
const address = s.address || site.address;
const options = s.topics?.length ? s.topics : topics;
// every country, by name (English), for the Country dropdown
const REGIONS = 'AD AE AF AG AI AL AM AO AR AS AT AU AW AX AZ BA BB BD BE BF BG BH BI BJ BL BM BN BO BQ BR BS BT BW BY BZ CA CD CF CG CH CI CK CL CM CN CO CR CU CV CW CY CZ DE DJ DK DM DO DZ EC EE EG EH ER ES ET FI FJ FK FM FO FR GA GB GD GE GF GG GH GI GL GM GN GP GQ GR GT GU GW GY HK HN HR HT HU ID IE IL IM IN IQ IR IS IT JE JM JO JP KE KG KH KI KM KN KP KR KW KY KZ LA LB LC LI LK LR LS LT LU LV LY MA MC MD ME MF MG MH MK ML MM MN MO MP MQ MR MS MT MU MV MW MX MY MZ NA NC NE NF NG NI NL NO NP NR NU NZ OM PA PE PF PG PH PK PL PM PN PR PS PT PW PY QA RE RO RS RU RW SA SB SC SD SE SG SH SI SK SL SM SN SO SR SS ST SV SX SY SZ TC TD TG TH TJ TK TL TM TN TO TR TT TV TW TZ UA UG US UY UZ VA VC VE VG VI VN VU WF WS XK YE YT ZA ZM ZW'.split(' ');
const regionName = new Intl.DisplayNames(['en'], { type: 'region' });
const countries = REGIONS.map((c) => regionName.of(c) || c).sort((a, b) => a.localeCompare(b));
const mapSrc = site.mapQuery ? `https://www.google.com/maps?q=${encodeURIComponent(site.mapQuery)}&output=embed` : '';
---
<section class="sec csec">
  <div class="csec-grid">
    <div class="csec-info rv">
      {s.eyebrow && <p class="eyebrow">{s.eyebrow}</p>}
      {s.heading && <h2><Rich text={s.heading} /></h2>}
      {s.intro && <p class="sec-intro">{s.intro}</p>}
      <dl class="cinfo">
        {email && <div><dt>{s.emailLabel}</dt><dd><a href={`mailto:${email}`}>{email}</a></dd></div>}
        {phones.length > 0 && <div><dt>{s.phoneLabel}</dt><dd>{phones.map((p: { label: string; number: string }) => <a href={`tel:${p.number}`}>{p.label}</a>)}</dd></div>}
        {hours && <div><dt>{s.hoursLabel}</dt><dd>{hours}</dd></div>}
        {address && <div><dt>{s.addressLabel}</dt><dd>{address}</dd></div>}
      </dl>
    </div>
    <form class="cform rv" id="enquiry" data-to={s.formTo || email} novalidate>
      {s.formHeading && <h3>{s.formHeading}</h3>}
      {s.formIntro && <p class="cform-intro">{s.formIntro}</p>}
      <div class="frow2">
        <label>{s.nameLabel}<input name="name" autocomplete="name" required></label>
        <label>{s.orgLabel}<input name="org" autocomplete="organization"></label>
      </div>
      <div class="frow2">
        <label>{s.emailFieldLabel}<input name="email" type="email" autocomplete="email" required></label>
        <label>{s.phoneFieldLabel}<input name="phone" type="tel" autocomplete="tel"></label>
      </div>
      <div class="frow2">
        <label>{s.countryLabel}
          <select name="country" autocomplete="country-name">
            <option value="">Select</option>
            {countries.map((c) => <option>{c}</option>)}
          </select>
        </label>
        <label>{s.topicLabel}
          <select name="topic">{options.map((t: string) => <option>{t}</option>)}</select>
        </label>
      </div>
      <label>{s.messageLabel}<textarea name="message" rows="5" required></textarea></label>
      {s.note && <p class="cform-note">{s.note}</p>}
      <p class="cform-err" role="alert" hidden>{s.errorText}</p>
      <button class="btn btn-gold" type="submit">{s.buttonLabel}</button>
    </form>
  </div>
  {mapSrc && (
    <div class="cmap rv">
      <iframe src={mapSrc} title={`Map: ${address}`} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
  )}
</section>

<script>
  const form = document.getElementById('enquiry') as HTMLFormElement | null;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const f = new FormData(form);
    const v = (k: string) => String(f.get(k) || '').trim();
    const err = form.querySelector<HTMLElement>('.cform-err')!;
    const ok = v('name') && /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(v('email')) && v('message');
    err.hidden = !!ok;
    if (!ok) return;
    const subject = `Enquiry: ${v('topic')}${v('org') ? ` – ${v('org')}` : ''}`;
    const body = [v('message'), '', v('name'), v('org'), v('email'), v('phone'), v('country')].filter((l, i) => i < 2 || l).join('\n');
    location.href = `mailto:${form.dataset.to}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  });
</script>
