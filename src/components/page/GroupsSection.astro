---
import SecHead from './SecHead.astro';
const { s } = Astro.props as { s: any };
const pad = (n: number) => String(n).padStart(2, '0');
---
<section class="sec gsec">
  <SecHead eyebrow={s.eyebrow} heading={s.heading} intro={s.intro} />
  <div class={`gsec-grid n${Math.min(s.groups.length, 4)}`}>
    {s.groups.map((g: any, i: number) => (
      <article class="gcard rv">
        <span class="gnum">{pad(i + 1)}</span>
        <h3>{g.title}</h3>
        <ul>{g.items.map((it: string) => <li>{it}</li>)}</ul>
      </article>
    ))}
  </div>
</section>
