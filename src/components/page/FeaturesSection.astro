---
import { imgAttrs, SIZES } from '../../lib/img-attrs';
import SecHead from './SecHead.astro';
const { s } = Astro.props as { s: any };
// 'auto' (default): photo cards when the items have images, otherwise title/description rows
const withImages = s.layout === 'cards' || (s.layout === 'auto' && s.items.some((i: any) => i.image));
---
<section class="sec fsec">
  <SecHead eyebrow={s.eyebrow} heading={s.heading} intro={s.intro} />
  {withImages ? (
    <div class="fcards">
      {s.items.map((it: any, i: number) => (
        <article class="fcard rv" style={`--i:${i % 3}`}>
          {it.image && <div class="fcard-img"><img {...imgAttrs(it.image, SIZES.third)} alt={it.image.alt} loading="lazy" decoding="async"></div>}
          <h3>{it.title}</h3>
          <p>{it.text}</p>
        </article>
      ))}
    </div>
  ) : s.layout === 'grid' ? (
    <dl class="fgrid">
      {s.items.map((it: any) => <div class="fgrid-item rv"><dt>{it.title}</dt><dd>{it.text}</dd></div>)}
    </dl>
  ) : (
    <dl class="frows">
      {s.items.map((it: any) => (
        <div class="frow rv"><dt>{it.title}</dt><dd>{it.text}</dd></div>
      ))}
    </dl>
  )}
</section>
