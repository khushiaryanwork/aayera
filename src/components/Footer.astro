---
import type { Site, Link } from '../lib/types';
const { site } = Astro.props as { site: Site };

/* One column per menu group that has sub-pages (About, Business Verticals, Our Platforms);
   single menu links (Industries, Contact) and the header button go together in a last column. */
const groups = site.nav
  .filter((n) => n.children?.length)
  .map((n) => ({ title: n.label, href: n.href, links: n.children as Link[] }));
const singles = site.nav.filter((n) => !n.children?.length).map(({ label, href }) => ({ label, href }));
if (site.navCta?.href && !singles.some((l) => l.label === site.navCta.label)) singles.push(site.navCta);
if (singles.length) groups.push({ title: 'Explore', href: '', links: singles });

const year = new Date().getFullYear();
const caret = '<svg viewBox="0 0 12 12" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5"/></svg>';
---
<footer class="foot">
  <div class="foot-top">
    <div class="foot-brand">
      <a href="/" aria-label="Aayera home"><img src={site.logo.src} alt={site.logo.alt || 'Aayera'} width="120" height="38"></a>
      {site.address && <address>{site.address}</address>}
      <ul class="foot-contact">
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        {site.phones.map((p) => <li><a href={`tel:${p.number}`}>{p.label}</a></li>)}
        {site.hours && <li class="foot-hours">{site.hours}</li>}
      </ul>
    </div>
    <nav class="foot-cols" aria-label="Footer">
      {groups.map((g, i) => (
        <div class="foot-col">
          {/* desktop: plain heading; phones: the heading is a button that opens the group */}
          <p class="foot-title">
            <span class="foot-title-text">{g.href ? <a href={g.href}>{g.title}</a> : g.title}</span>
            <button class="foot-toggle" type="button" aria-expanded="false" aria-controls={`foot-${i}`}>{g.title}<Fragment set:html={caret} /></button>
          </p>
          <div class="foot-panel" id={`foot-${i}`}>
            <ul>
              {g.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
            </ul>
          </div>
        </div>
      ))}
    </nav>
  </div>
  <div class="foot-bottom">
    <span>© {year} AAYERA. All rights reserved.</span>
  </div>
</footer>

<script>
  /* phones: footer groups are an accordion (one open at a time); wider screens show everything */
  const phone = matchMedia('(max-width:760px)');
  const cols = [...document.querySelectorAll<HTMLElement>('.foot-col')];
  const set = (col: HTMLElement, open: boolean) => {
    col.classList.toggle('open', open);
    col.querySelector('.foot-toggle')!.setAttribute('aria-expanded', String(open));
    (col.querySelector('.foot-panel') as HTMLElement).inert = phone.matches && !open;
  };
  const reset = () => cols.forEach((c) => set(c, false));
  cols.forEach((col) =>
    col.querySelector('.foot-toggle')!.addEventListener('click', () => {
      const open = !col.classList.contains('open');
      cols.forEach((c) => c !== col && set(c, false));
      set(col, open);
    }),
  );
  reset();
  phone.addEventListener('change', reset);
</script>
