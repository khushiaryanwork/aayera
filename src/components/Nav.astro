---
import type { Site } from '../lib/types';
import AnnouncementBar from './AnnouncementBar.astro';
const { site } = Astro.props as { site: Site };
const path = Astro.url.pathname.replace(/\/?$/, '/');
const isCurrent = (href: string) => href !== '/' && href.startsWith('/') && path.startsWith(href.replace(/\/?$/, '/'));
const caret = '<svg viewBox="0 0 12 12" width="10" height="10" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5"/></svg>';
---
<AnnouncementBar site={site} />
<header class={'nav' + (site.announcementOn ? ' has-bar' : '')} id="nav">
  <a href="/" aria-label="Aayera home"><img src={site.logo.src} alt={site.logo.alt || 'Aayera'}></a>
  <nav aria-label="Main">
    <ul class="nav-links">
      {site.nav.map((item) =>
        item.children?.length ? (
          <li class="has-sub">
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}<Fragment set:html={caret} /></a>
            <ul class="sub">
              {item.children.map((c) => <li><a href={c.href} aria-current={isCurrent(c.href) ? 'page' : undefined}>{c.label}</a></li>)}
            </ul>
          </li>
        ) : (
          <li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ),
      )}
    </ul>
  </nav>
  <div class="nav-end">
    <a class="btn btn-gold" href={site.navCta.href}>{site.navCta.label}</a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="mnav" aria-label="Open menu"><span></span><span></span></button>
  </div>
</header>

<div class="mnav" id="mnav" hidden>
  <ul>
    <li><a href="/">Home</a></li>
    {site.nav.map((item, i) => {
      if (!item.children?.length) return <li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>;
      // the group's own page goes first unless one of its sub-links already points to it
      const hasOverview = item.children.some((c) => c.href.replace(/\/?$/, '/') === item.href.replace(/\/?$/, '/'));
      const links = hasOverview ? item.children : [{ label: `${item.label} overview`, href: item.href }, ...item.children];
      const open = isCurrent(item.href);
      return (
        <li class={'macc' + (open ? ' open' : '')}>
          <button class="macc-btn" type="button" aria-expanded={String(open)} aria-controls={`macc-${i}`}>
            <span class={open ? 'cur' : undefined}>{item.label}</span><Fragment set:html={caret} />
          </button>
          <div class="macc-panel" id={`macc-${i}`} inert={!open}>
            <ul>{links.map((c) => <li><a href={c.href} aria-current={path === c.href.replace(/\/?$/, '/') ? 'page' : undefined}>{c.label}</a></li>)}</ul>
          </div>
        </li>
      );
    })}
    <li><a href={site.navCta.href}>{site.navCta.label}</a></li>
  </ul>
  <p class="mnav-foot"><a href={`mailto:${site.email}`}>{site.email}</a>{site.phones[0] && <><br><a href={`tel:${site.phones[0].number}`}>{site.phones[0].label}</a></>}</p>
</div>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.nav-toggle')!;
  const menu = document.getElementById('mnav')!;
  const set = (open: boolean) => {
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    menu.hidden = !open;
    document.documentElement.classList.toggle('menu-open', open);
  };
  btn.addEventListener('click', () => set(menu.hidden));
  menu.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) set(false); });
  addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) set(false); });
  matchMedia('(min-width:861px)').addEventListener('change', (m) => { if (m.matches) set(false); });

  /* accordion: one group open at a time */
  const groups = [...menu.querySelectorAll<HTMLElement>('.macc')];
  const toggle = (g: HTMLElement, open: boolean) => {
    g.classList.toggle('open', open);
    g.querySelector('.macc-btn')!.setAttribute('aria-expanded', String(open));
    (g.querySelector('.macc-panel') as HTMLElement).inert = !open;
  };
  groups.forEach((g) =>
    g.querySelector('.macc-btn')!.addEventListener('click', () => {
      const open = !g.classList.contains('open');
      groups.forEach((o) => o !== g && toggle(o, false));
      toggle(g, open);
    }),
  );
</script>
