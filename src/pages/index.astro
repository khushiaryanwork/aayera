---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Marquee from '../components/Marquee.astro';
import Moments from '../components/Moments.astro';
import WhoWeAre from '../components/WhoWeAre.astro';
import VerticalTiles from '../components/page/VerticalTiles.astro';
import IndustryGrid from '../components/page/IndustryGrid.astro';
import PlatformCards from '../components/page/PlatformCards.astro';
import Filmstrip from '../components/Filmstrip.astro';
import Cta from '../components/Cta.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero';
import EventsTrack from '../components/EventsTrack';
import Statement from '../components/Statement';
import Stats from '../components/Stats';
import Clients from '../components/Clients';
import { getContent } from '../lib/content';

const { site, home, noindex, verticals, industries, platforms } = await getContent();
---
<Base site={site} noindex={noindex}>
  <Nav site={site} />
  <Hero client:load {...home.hero} />
  <Marquee words={home.marquee} />
  <!-- order follows the content brief: who we are → verticals → industries → platforms → work → partners → contact -->
  <WhoWeAre who={home.whoWeAre} />
  <VerticalTiles head={home.verticalsHead} verticals={verticals} />
  <IndustryGrid head={home.industriesHead} industries={industries} cta={{ label: 'Explore industries →', href: '/industries/' }} />
  <Statement client:load {...home.statement} />
  <PlatformCards head={home.platformsHead} platforms={platforms} compact />
  <EventsTrack client:load {...home.events} />
  <Stats client:visible={{ rootMargin: '600px' }} items={home.stats} />
  <Moments moments={home.moments} />
  <Filmstrip images={home.filmstrip} />
  <Clients client:visible={{ rootMargin: '600px' }} {...home.clients} />
  <Cta cta={home.cta} />
  <Footer site={site} />
</Base>
