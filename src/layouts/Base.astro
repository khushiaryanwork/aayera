---
import '../styles/global.css';
import '../styles/pages.css';
import type { Site } from '../lib/types';
import FloatingSocials from '../components/FloatingSocials.astro';
interface Props { site: Site; noindex?: boolean; title?: string; description?: string }
const { site, noindex } = Astro.props;
const title = Astro.props.title || site.title;
const description = Astro.props.description || site.description;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  {noindex && <meta name="robots" content="noindex, nofollow">}
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  {site.shareImage && <meta property="og:image" content={site.shareImage}>}
  <link rel="icon" href={site.logo.src}>
  <script is:inline>if (matchMedia('(prefers-reduced-motion: no-preference)').matches) document.documentElement.classList.add('motion');</script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,700&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">
</head>
<body>
  <slot />
  <FloatingSocials site={site} />
  <script>
    // page-wide motion (reveals, nav/bar state, CTA parallax) and Astro-rendered loops
    import { initPageMotion } from '../lib/motion/page';
    import { initDataLoops } from '../lib/motion/loop';
    initPageMotion();
    initDataLoops();
  </script>
</body>
</html>
